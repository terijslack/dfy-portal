{
  "name": "dfy-portal",
  "version": "1.0.0",
  "description": "Client portal for DFY Marketing — clients approve posts, approved posts go to Buffer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit"
  },
  "jest": {
    "projects": [
      {
        "displayName": "backend",
        "testEnvironment": "node",
        "testMatch": ["<rootDir>/backend/tests/**/*.test.js"]
      },
      {
        "displayName": "frontend",
        "testEnvironment": "jest-environment-jsdom",
        "testMatch": ["<rootDir>/frontend/tests/**/*.test.js"]
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.11.3",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
