# Copy this file to .env and fill in your real values
# NEVER commit your actual .env file to GitHub

# ── Database ──────────────────────────────────────────────────────────────────
# Get this from Railway → your Postgres service → Variables tab
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
# Make up any long random string — this signs your login tokens
JWT_SECRET=make-this-long-and-random-like-this-abc123xyz789

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from dashboard.stripe.com → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here

# ── Email (welcome, password reset, contact-form alerts) ─────────────────────
# Sent through Google Workspace from the noreply mailbox. SMTP_PASS is an App
# Password for that mailbox: Google Account → Security → 2-Step Verification →
# App passwords. Without these two the portal skips sending and logs a warning.
SMTP_USER=noreply@dfymarketinggroup.com
SMTP_PASS=your-16-character-app-password
# Optional (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM=Done For You Marketing <noreply@dfymarketinggroup.com>
# EMAIL_REPLY_TO=hello@dfymarketinggroup.com
# EMAIL_TEAM=hello@dfymarketinggroup.com

# ── App URL ───────────────────────────────────────────────────────────────────
# Your public Railway URL — used for Stripe redirect links after checkout
APP_URL=https://your-app-name.up.railway.app

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets this automatically — leave as 3000 locally
PORT=3000

# ── Metricool ─────────────────────────────────────────────────────────────────
# Get these from Metricool → Settings → API. One token covers your whole agency
# account; which client each post schedules under is set per-account in the
# admin (Metricool brand ID), not here.
METRICOOL_USER_TOKEN=your-metricool-user-token-here
METRICOOL_USER_ID=your-metricool-user-id-here
# Optional — only needed if you want posts scheduled at a time/zone other than
# 10:00 AM Pacific by default (posts only store a date, not a time of day)
METRICOOL_DEFAULT_TIME=10:00:00
METRICOOL_DEFAULT_TIMEZONE=America/Los_Angeles
